{
	"name": "shell-extras",
	"version": "0.1.0",
	"private": true,
	"description": "Personal Gentle Shell extras: a tabbed sidebar section with a file explorer, Git, project, system, Spotify and Engram widgets.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./extensions/file-explorer.ts",
			"./extensions/git-tab.ts",
			"./extensions/project-tab.ts"
		]
	},
	"scripts": {
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "^24.13.3",
		"typescript": "^5.9.3"
	}
}
